---
import '../styles/theme.css';
import { withBase } from '../scripts/paths';

interface Props {
  title: string;
  duration?: string;
  // 'landing' skips the default <h1>/duration wrapper so the course home
  // page can supply its own full-bleed hero markup via the slot instead.
  variant?: 'default' | 'landing';
}

const { title, duration, variant = 'default' } = Astro.props;

// Mirrors contentObjects.json's page list - hand-maintained for now.
// (In the Adapt version this tree is generated across 5 JSON files;
// here it's just this one array.)
const pages = [
  { title: 'Introduction', href: '/introduction/' },
  { title: 'Data Collection', href: '/data-collection/' },
  { title: 'Data Storage', href: '/data-storage/' },
  { title: 'Data Usage', href: '/data-usage/' },
  { title: 'Data Sharing', href: '/data-sharing/' },
  { title: 'Data Destruction', href: '/data-destruction/' },
  { title: 'Conclusion', href: '/conclusion/' },
];

// Several pages' own copy says "Select Next to continue" - a leftover
// expectation from the original Adapt course, which had built-in
// page-level Next/Back buttons. Matched by title (every content page
// passes its title as a Layout prop already) rather than by URL, so this
// doesn't need Astro.url/base-path handling. Naturally excludes the
// landing page, whose title ("Data Ethics") isn't in this list.
const currentIndex = pages.findIndex((p) => p.title === title);
const prevPage = currentIndex > 0 ? pages[currentIndex - 1] : null;
const nextPage = currentIndex !== -1 && currentIndex < pages.length - 1 ? pages[currentIndex + 1] : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - Analytics8 // Data Ethics</title>

    <!-- PWA installability: manifest + icons + theme colour. The service
         worker itself is registered from the inline script below, not
         linked here - <link rel="manifest"> is what iOS/Android read to
         build the "Add to Home Screen" icon/name/standalone-display, see
         src/pages/manifest.webmanifest.ts. -->
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <meta name="theme-color" content="#c24429" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/icons/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/icons/favicon-16.png')} />
    <!-- iOS ignores <link rel="manifest"> for home-screen icon/standalone
         behaviour - these two tags are what it actually reads. -->
    <link rel="apple-touch-icon" href={withBase('/icons/apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Data Ethics" />
  </head>
  <body>
    <header class="a8-header">
      <div class="a8-container a8-header__inner">
        <a href={withBase('/')} class="a8-logo" aria-label="Analytics8 home">
          <img src={withBase('/assets/logo-analytics8.png')} alt="Analytics8" />
        </a>
        <nav class="a8-nav" aria-label="Course navigation">
          <ul>
            <li><a href={withBase('/')}>Home</a></li>
            {pages.map((p) => (
              <li><a href={withBase(p.href)} data-page-link>{p.title}</a></li>
            ))}
          </ul>
        </nav>
        <div class="a8-progress" role="progressbar" aria-label="Course progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <div class="a8-progress__track">
            <div class="a8-progress__fill" data-progress-fill></div>
          </div>
          <p class="a8-progress__label" data-progress-label>0/{pages.length}</p>
        </div>
      </div>
    </header>

    {variant === 'landing' ? (
      <main class="a8-main a8-main--landing">
        <slot />
      </main>
    ) : (
      <main class="a8-container a8-main">
        <h1>{title}</h1>
        {duration && <p class="a8-duration">Duration: {duration}</p>}
        <slot />
      </main>
    )}

    {currentIndex !== -1 && (
      <nav class="a8-container a8-page-nav" aria-label="Page navigation">
        {prevPage ? (
          <a href={withBase(prevPage.href)} class="a8-page-nav__link a8-page-nav__link--prev">← {prevPage.title}</a>
        ) : <span />}
        {nextPage ? (
          <a href={withBase(nextPage.href)} class="a8-page-nav__link a8-page-nav__link--next">Next: {nextPage.title} →</a>
        ) : (
          <a href={withBase('/')} class="a8-page-nav__link a8-page-nav__link--next">Back to Home →</a>
        )}
      </nav>
    )}

    <footer class="a8-footer">
      <div class="a8-container a8-footer__inner">
        <p>Analytics8 // Data Ethics</p>
        <button type="button" class="a8-reset" data-reset-progress>Reset progress</button>
      </div>
    </footer>

    <style>
      .a8-header {
        background: var(--a8-surface);
        border-bottom: 2px solid var(--a8-rule);
      }
      .a8-header__inner {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--a8-space-lg);
        padding-top: var(--a8-space-md);
        padding-bottom: var(--a8-space-md);
      }
      .a8-header__inner .a8-nav {
        margin-right: auto;
      }
      .a8-logo {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
      }
      .a8-logo img {
        display: block;
        height: 48px;
        width: auto;
      }
      .a8-nav ul {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: var(--a8-space-md);
        margin: 0;
        padding: 0;
      }
      .a8-nav a {
        color: var(--a8-text-muted);
        text-decoration: none;
        font-size: 0.9rem;
      }
      .a8-nav a:hover,
      .a8-nav a:focus {
        color: var(--a8-accent);
      }
      .a8-nav a[data-visited]::after {
        content: ' \2713'; /* checkmark */
        color: var(--a8-accent);
        font-weight: 700;
      }
      .a8-nav a[aria-current='page'] {
        color: var(--a8-ink);
        font-weight: 700;
      }
      .a8-progress {
        display: flex;
        align-items: center;
        gap: var(--a8-space-sm);
        width: 90px;
        flex-shrink: 0;
      }
      .a8-progress__track {
        flex: 1;
        height: 6px;
        background: #ddd;
        border-radius: 999px;
        overflow: hidden;
      }
      .a8-progress__fill {
        height: 100%;
        width: 0%;
        background: var(--a8-accent);
        transition: width 0.3s ease;
      }
      .a8-progress__label {
        margin: 0;
        font-size: 0.8rem;
        color: var(--a8-text-muted);
        white-space: nowrap;
      }
      .a8-main {
        padding-top: var(--a8-space-lg);
        padding-bottom: var(--a8-space-lg);
        min-height: 60vh;
      }
      .a8-main--landing {
        padding: 0;
      }
      .a8-page-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--a8-space-md);
        padding-bottom: var(--a8-space-lg);
      }
      .a8-page-nav__link {
        color: var(--a8-ink);
        text-decoration: none;
        font-weight: 700;
        border: 1px solid var(--a8-ink);
        border-radius: var(--a8-radius);
        padding: 0.5rem 1rem;
      }
      .a8-page-nav__link:hover,
      .a8-page-nav__link:focus {
        background: var(--a8-accent);
        border-color: var(--a8-accent);
        color: var(--a8-accent-text);
      }
      .a8-duration {
        color: var(--a8-text-muted);
        font-size: 0.9rem;
        margin-top: -0.5rem;
      }
      .a8-footer {
        background: var(--a8-ink);
        color: var(--a8-bg);
        padding: var(--a8-space-md) 0;
        font-size: 0.85rem;
      }
      .a8-footer__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--a8-space-md);
        flex-wrap: wrap;
      }
      .a8-footer p {
        margin: 0;
      }
      .a8-reset {
        background: none;
        border: 1px solid var(--a8-bg);
        color: var(--a8-bg);
        border-radius: var(--a8-radius);
        padding: 0.25rem 0.75rem;
        font-size: 0.8rem;
        cursor: pointer;
        opacity: 0.7;
      }
      .a8-reset:hover,
      .a8-reset:focus {
        opacity: 1;
      }

      /* :global() because this targets the toast element
         showOfflineReadyToast() creates at runtime, below - it isn't
         present in this component's template, so it wouldn't otherwise
         get Astro's scoped data-astro-cid attribute.

         Deliberately NOT position:fixed - an earlier version (in the
         sibling AI Ethics course) floated this over the bottom of the
         viewport, which meant it could sit directly on top of page
         content for the few seconds it's visible. Inserted in normal
         document flow at the very top of <body> instead (see
         showOfflineReadyToast() above), so it pushes the page down rather
         than covering any of it. */
      :global(.a8-toast) {
        display: block;
        background: var(--a8-ink);
        color: #fff;
        font-size: 0.9rem;
        text-align: center;
        padding: 0 var(--a8-space-md);
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: max-height 0.3s ease, opacity 0.3s ease, padding 0.3s ease;
      }
      :global(.a8-toast--visible) {
        max-height: 6rem;
        opacity: 1;
        padding: var(--a8-space-sm) var(--a8-space-md);
      }
    </style>

    <script>
      // UI wiring only - the actual persistence lives in
      // src/scripts/tracking.ts, shared with Mcq.astro. That's the one file
      // to change if SCORM reporting is ever added; this script just reads
      // its results back out and updates the nav/progress-bar DOM.
      import { recordPageVisit, normalisePath, resetProgress } from '../scripts/tracking';
      import { withBase } from '../scripts/paths';

      // Registers src/pages/sw.js.ts - safe to call on every load; the
      // browser no-ops if the registration is unchanged, and re-installs
      // it (see CACHE_VERSION in that file) when it isn't. Feature-detected
      // since older browsers, and non-browser contexts, don't have this API.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register(withBase('/sw.js'))
            .then((registration) => {
              // The service worker's install step (see sw.js.ts) downloads
              // every page up front via cache.addAll() - it doesn't need
              // the learner to click through pages themselves. But that
              // download happens silently, so there's otherwise no way to
              // tell it's finished (and therefore safe to go offline) -
              // this surfaces it. `registration.installing`/`.waiting` is
              // only set the first time this SW version installs; on a
              // later visit where it's already active, there's nothing new
              // to report, so no toast.
              const worker = registration.installing || registration.waiting;
              if (!worker) return;
              worker.addEventListener('statechange', () => {
                // Reaching 'activated' only happens if the install step's
                // cache.addAll() resolved - a failed download leaves the
                // worker stuck in a failed/redundant state instead, so this
                // is a reliable "fully cached" signal, not a guess.
                if (worker.state === 'activated') {
                  showOfflineReadyToast();
                }
              });
            })
            .catch(() => {
              // Installability is a progressive enhancement here, not a
              // requirement - the course works the same without it.
            });
        });
      }

      function showOfflineReadyToast() {
        const toast = document.createElement('div');
        toast.className = 'a8-toast';
        toast.setAttribute('role', 'status');
        toast.textContent = 'This course is downloaded and ready to use offline.';
        // Inserted as the very first thing in <body> (above the header),
        // in normal document flow rather than a fixed overlay - see the
        // .a8-toast CSS comment for why.
        document.body.insertBefore(toast, document.body.firstChild);
        // Let the browser register the initial (pre-transition) state
        // before flipping the class that transitions it in.
        requestAnimationFrame(() => toast.classList.add('a8-toast--visible'));
        setTimeout(() => {
          toast.classList.remove('a8-toast--visible');
          toast.addEventListener('transitionend', () => toast.remove(), { once: true });
        }, 5000);
      }

      document.querySelector('[data-reset-progress]')?.addEventListener('click', () => {
        if (window.confirm('Reset all page-visited and quiz progress for this course?')) {
          resetProgress();
          window.location.reload();
        }
      });

      function updateUI(visited: string[]) {
        const visitedSet = new Set(visited);
        const links = document.querySelectorAll<HTMLAnchorElement>('[data-page-link]');
        const currentPath = normalisePath(window.location.pathname);

        links.forEach((link) => {
          const linkPath = normalisePath(new URL(link.href).pathname);
          if (linkPath === currentPath) {
            link.setAttribute('aria-current', 'page');
          }
          if (visitedSet.has(linkPath)) {
            link.setAttribute('data-visited', 'true');
          }
        });

        const total = links.length;
        // Only count visited pages that are actually part of this course's
        // nav (guards against stale entries if pages are ever renamed).
        const knownVisited = Array.from(links).filter((link) =>
          visitedSet.has(normalisePath(new URL(link.href).pathname))
        ).length;
        const percent = total > 0 ? Math.round((knownVisited / total) * 100) : 0;

        const fill = document.querySelector<HTMLElement>('[data-progress-fill]');
        const label = document.querySelector<HTMLElement>('[data-progress-label]');
        const bar = document.querySelector<HTMLElement>('.a8-progress');
        if (fill) fill.style.width = `${percent}%`;
        if (label) label.textContent = `${knownVisited}/${total}`;
        if (bar) bar.setAttribute('aria-valuenow', String(percent));
      }

      updateUI(recordPageVisit(window.location.pathname));
    </script>
  </body>
</html>
