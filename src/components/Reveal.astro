---
// Recreates Adapt's "reveal" component type (adapt-contrib-reveal) - an
// image/text panel that's replaced by a second image/text panel on click,
// with a toggle to go back. Used in the current course as a simple
// before/after ("here's the image - now here's the detail") reveal.
import { withBase } from '../scripts/paths';

interface RevealPanel {
  src: string;
  alt?: string;
  body?: string;
}

interface Props {
  id: string;
  title?: string;
  first: RevealPanel;
  second: RevealPanel;
  showText?: string;
  hideText?: string;
}

const { id, title, first, second, showText = 'Show', hideText = 'Hide' } = Astro.props;

// A panel with body text is the "reveal" payload itself - in the source
// Adapt course its image was a dark background swatch (_classes:
// "background-colour8"), not a standalone photo. Rendered as a plain <img>
// it just looks like a broken/black box sitting above the text, so panels
// with body text get the image as a background wash behind the copy
// instead; an image-only panel (no body) still renders as a normal photo.
function panelStyle(panel: { src: string }) {
  return `background-image: linear-gradient(rgba(26, 26, 26, 0.72), rgba(26, 26, 26, 0.72)), url(${withBase(panel.src)})`;
}
---

<section class="a8-reveal" data-reveal-id={id}>
  {title && <h2>{title}</h2>}

  <div class="a8-reveal__panel" data-reveal-panel="first">
    {first.body ? (
      <div class="a8-reveal__card" style={panelStyle(first)} role={first.alt ? 'img' : undefined} aria-label={first.alt || undefined}>
        <div class="a8-prose" set:html={first.body} />
      </div>
    ) : (
      <img src={withBase(first.src)} alt={first.alt ?? ''} />
    )}
  </div>

  <div class="a8-reveal__panel" data-reveal-panel="second" hidden>
    {second.body ? (
      <div class="a8-reveal__card" style={panelStyle(second)} role={second.alt ? 'img' : undefined} aria-label={second.alt || undefined}>
        <div class="a8-prose" set:html={second.body} />
      </div>
    ) : (
      <img src={withBase(second.src)} alt={second.alt ?? ''} />
    )}
  </div>

  <button type="button" class="a8-reveal__toggle" data-reveal-toggle data-show-text={showText} data-hide-text={hideText}>
    {showText}
  </button>
</section>

<style>
  .a8-reveal {
    margin: var(--a8-space-lg) 0;
  }
  .a8-reveal__panel img {
    max-width: 100%;
    border-radius: var(--a8-radius);
  }
  .a8-reveal__card {
    min-height: 260px;
    border-radius: var(--a8-radius);
    background-size: cover;
    background-position: center;
    color: #fff;
    padding: var(--a8-space-lg);
    display: flex;
    align-items: center;
  }
  /* No single accent shade clears 4.5:1 against both a light page
     background and this card's dark overlay - rather than pick one and
     fail the other, links on this dark card inherit the card's own white
     text colour instead; the underline (set globally on a.customlink)
     still marks them as links without relying on colour alone. */
  .a8-reveal__card :global(a.customlink) {
    color: inherit;
  }
  .a8-reveal__toggle {
    display: block;
    margin-top: var(--a8-space-sm);
    background: var(--a8-accent);
    color: var(--a8-accent-text);
    border: none;
    border-radius: var(--a8-radius);
    padding: 0.5rem 1.25rem;
    font-weight: 700;
    cursor: pointer;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.a8-reveal').forEach((el) => {
    const toggle = el.querySelector<HTMLButtonElement>('[data-reveal-toggle]');
    const first = el.querySelector<HTMLElement>('[data-reveal-panel="first"]');
    const second = el.querySelector<HTMLElement>('[data-reveal-panel="second"]');
    if (!toggle || !first || !second) return;

    const showText = toggle.dataset.showText ?? 'Show';
    const hideText = toggle.dataset.hideText ?? 'Hide';

    toggle.addEventListener('click', () => {
      const revealed = !second.hidden;
      first.hidden = !revealed;
      second.hidden = revealed;
      toggle.textContent = revealed ? showText : hideText;
    });
  });
</script>
