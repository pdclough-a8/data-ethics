---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../scripts/paths';

// Real copy, from course/en/course.json's title/body/_menu fields (the
// course "home" page Adapt renders separately from the 7 topic pages).
const introBody = `<p>The world is more connected and data-enabled than ever. Organisations of all shapes and sizes use data to make decisions on everything from where to locate a particular service or new store to how to route council waste collections.</p><p>This use of data has led to considerations of data ethics — especially where data may be used to make decisions that could negatively affect people, organisations or society in general. In this course, you'll learn more about data ethics and how to put it into practice in your own organisation.</p><p>This content was written and curated by Paul Clough, Lead Data Science and AI Consultant at Analytics8 and Professor Emeritus at the University of Sheffield.</p><p><strong>Select 'Introduction' to begin.</strong></p>`;

const menuInstructionText = 'Click or tap on the blocks below to find out more';

const pages = [
  { title: 'Introduction', href: '/introduction/' },
  { title: 'Data Collection', href: '/data-collection/' },
  { title: 'Data Storage', href: '/data-storage/' },
  { title: 'Data Usage', href: '/data-usage/' },
  { title: 'Data Sharing', href: '/data-sharing/' },
  { title: 'Data Destruction', href: '/data-destruction/' },
  { title: 'Conclusion', href: '/conclusion/' },
];
---

<Layout title="Data Ethics" variant="landing">
  <section class="a8-hero">
    <div class="a8-container a8-hero__inner">
      <div class="a8-hero__text">
        <h1>Data Ethics</h1>
        <div class="a8-prose" set:html={introBody} />
      </div>
      <div class="a8-hero__image">
        <img src={withBase('/assets/landing-hero.jpg')} alt="" />
      </div>
    </div>
  </section>

  <section class="a8-menu a8-container">
    <p class="a8-menu__instruction">{menuInstructionText}</p>
    <div class="a8-menu__grid">
      {pages.map((p) => (
        <a href={withBase(p.href)} class="a8-menu__tile">{p.title}</a>
      ))}
    </div>
  </section>
</Layout>

<style>
  /* Solid dark backdrop behind the text — no image sits behind the copy,
     so contrast stays reliable regardless of what the illustration looks
     like. The illustration itself sits in its own column to the side. */
  .a8-hero {
    background: var(--a8-ink);
    color: #fff;
  }
  .a8-hero__inner {
    display: flex;
    align-items: center;
    gap: var(--a8-space-lg);
    padding-top: var(--a8-space-lg);
    padding-bottom: var(--a8-space-lg);
  }
  .a8-hero__text {
    flex: 1 1 20rem;
    min-width: 0;
  }
  .a8-hero__image {
    flex: 1 1 16rem;
    max-width: 22rem;
  }
  .a8-hero__image img {
    display: block;
    width: 100%;
    border-radius: var(--a8-radius);
  }
  @media (max-width: 640px) {
    .a8-hero__image {
      display: none;
    }
  }
  .a8-hero h1 {
    color: #fff;
    font-size: 2rem;
    border-bottom: 1px solid #fff;
    padding-bottom: var(--a8-space-sm);
    margin-bottom: var(--a8-space-md);
  }
  .a8-hero .a8-prose :global(p) {
    margin: 0 0 var(--a8-space-md);
  }
  .a8-menu {
    padding-top: var(--a8-space-lg);
    padding-bottom: var(--a8-space-lg);
  }
  .a8-menu__instruction {
    color: var(--a8-text-muted);
    font-size: 0.9rem;
  }
  .a8-menu__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--a8-space-md);
  }
  .a8-menu__tile {
    background: var(--a8-accent);
    color: var(--a8-accent-text);
    font-weight: 700;
    font-family: var(--a8-font-heading);
    text-decoration: none;
    border-radius: var(--a8-radius);
    padding: var(--a8-space-md);
    min-height: 6rem;
    display: flex;
    align-items: flex-start;
  }
  .a8-menu__tile:hover,
  .a8-menu__tile:focus {
    outline: 2px solid var(--a8-ink);
    outline-offset: 2px;
  }
</style>
